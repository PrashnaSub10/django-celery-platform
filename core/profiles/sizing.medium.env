SERVER_PROFILE=medium

# ── Concurrency & Performance ──
FAST_CONCURRENCY=50
CRITICAL_CONCURRENCY=2
# prefork: solo would serialize the "critical" lane — one slow PDF export or
# SMTP send blocks every payment/audit task behind it. prefork + acks_late +
# prefetch_multiplier=1 keeps delivery guarantees with real parallelism.
# Override to CRITICAL_POOL=solo only for thread-unsafe C extensions.
CRITICAL_POOL=prefork

# ── Memory Constraints ──
FAST_MAX_MEMORY=200000       # ~200MB
CRITICAL_MAX_MEMORY=300000   # ~300MB

# WHY: Designed for 4 CPUs and 8GB RAM.
# Balanced performance. Optionally add RabbitMQ.
